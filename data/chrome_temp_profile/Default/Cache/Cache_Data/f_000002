          <td>INR ${parseFloat(taxAmt).toLocaleString('en-IN', {minimumFractionDigits: 2})}</td>
          <td><span class="pill ${statusClass}">${doc.status}</span></td>
          <td>${actionButtons}</td>
        </tr>

  btnRefreshHistory.addEventListener("click", fetchMappingHistory);

  async function fetchMappingHistory() {
    try {
      const res = await fetch("/mapping-history");
      if (!res.ok) return;
      const history = await res.json();

      if (!history || history.length === 0) {
        historyTbody.innerHTML = `<tr><td colspan="8" class="empty-cell">No historical mapping corrections recorded yet.</td></tr>`;
        return;
      }

      historyTbody.innerHTML = history.map(item => {
        let typeClass = "neutral";
        if (item.mapping_type.includes("RESPONSE") || item.mapping_type.includes("REGISTER") || item.mapping_type.includes("COMPARE")) {
          typeClass = "gold";
        } else if (item.mapping_type === "VENDOR") {
          typeClass = "info";
        }

        let payloadDisplay = item.field_payload || "Standard Mapping";
        if (payloadDisplay.includes("MATCH ✅")) {
          payloadDisplay = `<span class="pill success" style="font-size:0.75rem;">${payloadDisplay}</span>`;
        } else if (payloadDisplay.includes("DELTA ⚠️")) {
          payloadDisplay = `<span class="pill warning" style="font-size:0.75rem;">${payloadDisplay}</span>`;
        } else if (payloadDisplay.includes("CAPTURED ✅")) {
          payloadDisplay = `<span class="pill gold" style="font-size:0.75rem;">${payloadDisplay}</span>`;
        } else {
          payloadDisplay = `<code>${payloadDisplay}</code>`;
        }

        return `
          <tr>
            <td>#${item.history_id}</td>
            <td><strong>${item.supplier_name || 'N/A'}</strong></td>
            <td><code>${item.ocr_value}</code></td>
            <td><code>${item.ai_value || 'None'}</code></td>
            <td><strong style="color: var(--sap-gold);">${item.final_correct_value}</strong></td>
            <td><span class="pill ${typeClass}">${item.mapping_type}</span></td>
            <td>${payloadDisplay}</td>
            <td><small>${new Date(item.correction_date).toLocaleString()}</small></td>
          </tr>
        `;
      }).join("");
    } catch (err) {
      console.error(err);
    }
  }

  function updateDocumentUI(doc) {
    statusPill.textContent = doc.status;
    if (sapDocNumDisplay) sapDocNumDisplay.textContent = `[Document ID: ${doc.document_id.substring(0, 8)}]`;

    if (doc.status === "VALIDATED" || doc.status === "APPROVED" || doc.status === "SAP_DRAFT_READY") {
      statusPill.className = "pill success";
    } else if (doc.status === "NEEDS_REVIEW") {
      statusPill.className = "pill warning";
    } else {
      statusPill.className = "pill neutral";
    }

    let html = `<div class="console-title">Validation Output for Document: ${doc.document_id}</div>`;
    html += `<b>Status:</b> ${doc.status} | <b>CardCode:</b> ${doc.invoice.supplier.sap_card_code || 'Unmapped'}<br>`;

    if (doc.validation) {
      html += `<b>Validation Passed:</b> ${doc.validation.passed ? "YES ✅" : "NO ❌"} | <b>Confidence:</b> ${doc.validation.overall_confidence}%<br>`;

      if (doc.validation.issues && doc.validation.issues.length > 0) {
        html += `<span style="color: var(--accent-rose); font-weight: 700;">Validation Issues:</span><ul>`;
        doc.validation.issues.forEach(issue => {
          html += `<li>[${issue.code}] ${issue.message}</li>`;

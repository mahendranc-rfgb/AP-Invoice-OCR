    }

    documentsTbody.innerHTML = filteredDocs.map(doc => {
      const h = doc.invoice.invoice_header;
      const s = doc.invoice.supplier || {};
      const total = doc.invoice.totals.grand_total;
      const taxAmt = doc.invoice.totals.tax_amount;

      const docNumDisplay = doc.sap_doc_num ? `<span class="pill gold">#${doc.sap_doc_num}</span>` : `<span class="pill neutral">Unposted</span>`;
      const docEntryDisplay = doc.sap_doc_entry ? `<code>${doc.sap_doc_entry}</code>` : `<span class="text-dim">—</span>`;


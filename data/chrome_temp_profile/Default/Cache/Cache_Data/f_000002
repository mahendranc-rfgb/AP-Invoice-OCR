window.saveWtaxCode = async function() {
  const code = document.getElementById("wtax-code-input").value;
  const desc = document.getElementById("wtax-desc-input").value;
  const rate = document.getElementById("wtax-rate-input").value;
  const type = document.getElementById("wtax-type-input").value;
  const active = document.getElementById("wtax-active-input").value;

  if (!code) {
    showToast("WTax Code is required", "warning");
    return;
  }

  try {
    const res = await fetch("/admin/wtax-codes", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ wtax_code: code, description: desc, wtax_rate: rate, wtax_type: type, active: active === "1" })
    });
    if (!res.ok) throw new Error("Failed to save WHT code");
    showToast(`Saved WHT Code ${code}`, "success");
    document.getElementById("wtax-code-input").value = "";
    document.getElementById("wtax-desc-input").value = "";
    document.getElementById("wtax-rate-input").value = "";
    renderAdminWtaxTable();
  } catch (err) {
    showToast(err.message, "danger");
  }
};

window.deleteWtaxCode = async function(code) {
  if (!confirm(`Delete WHT Code ${code}?`)) return;
  try {
    const res = await fetch(`/admin/wtax-codes?wtax_code=${encodeURIComponent(code)}`, { method: "DELETE" });
    if (!res.ok) throw new Error("Failed to delete WHT code");
    showToast(`Deleted WHT Code ${code}`, "info");
    renderAdminWtaxTable();
  } catch (err) {
    showToast(err.message, "danger");
  }
};


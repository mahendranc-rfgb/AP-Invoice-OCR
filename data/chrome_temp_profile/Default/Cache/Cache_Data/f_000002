  async function runApprove() {
    if (!currentDocument) {
      showToast("Please upload or validate a document first by clicking '1. Validate Document'.", "warning");
      return;
    }
    try {
      const res = await fetch(`/documents/${currentDocument.document_id}/approve`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ approved_by: "SAP Manager" }),
      });

      if (!res.ok) {
        const err = await res.json();
        throw new Error(err.detail || "Authorization failed");
      }

      currentDocument = await res.json();
      updateDocumentUI(currentDocument);
      await fetchQueue();
      updateStepper(3);
      showToast("Document Authorized! Step 2 Complete -> Ready to Post to SAP B1.", "success");
    } catch (err) {
      showToast(err.message, "danger");
    }
  }


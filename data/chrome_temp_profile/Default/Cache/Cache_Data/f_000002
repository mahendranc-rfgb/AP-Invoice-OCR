  async function handlePortalLogin(e) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }
    const roleSelect = document.getElementById("auth-role-input");
    let role = roleSelect ? roleSelect.value : "";
    const usernameInput = document.getElementById("auth-username-input");
    const passwordInput = document.getElementById("auth-password-input");
    const username = usernameInput ? usernameInput.value : "";
    const password = passwordInput ? passwordInput.value : "";

    if (!username || !password) {
      showToast("Please enter both username and password.", "warning");
      return false;
    }

    if (username.trim().toLowerCase() === "admin" && roleSelect) {
      roleSelect.value = "admin";
      role = "admin";
    }

    try {
      const res = await fetch("/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ username, password, role })
      });
      if (!res.ok) {
        const err = await res.json();
        throw new Error(err.detail || "Authentication failed");
      }

      const data = await res.json();
      currentUserRole = data.role;
      currentUsername = data.username;

      sessionStorage.setItem("user_role", data.role);
      sessionStorage.setItem("username", data.username);

      updateAuthUI();
      if (data.role === "admin") {
        switchPage("admin");
      } else {
        switchPage("dashboard");
      }
      showToast(`Welcome ${data.username}! Logged in as ${data.role.toUpperCase()}`, "success");
    } catch (err) {
      showToast(err.message, "danger");
    }
    return false;
  }

  window.handlePortalLogin = handlePortalLogin;

  if (authForm) {
    authForm.addEventListener("submit", handlePortalLogin);
  }

  const btnSubmitAuth = document.getElementById("btn-submit-auth");
  if (btnSubmitAuth) {
    btnSubmitAuth.addEventListener("click", handlePortalLogin);
  }

  if (btnLogout) {
    btnLogout.addEventListener("click", () => {
      sessionStorage.clear();
      currentUserRole = null;
      currentUsername = null;
      updateAuthUI();
      showToast("Logged out successfully.", "info");
    });
  }

  const roleBadgeEl = document.getElementById("user-role-badge");
  if (roleBadgeEl) {
    roleBadgeEl.addEventListener("click", () => {
      const authModal = document.getElementById("auth-modal");
      if (authModal) authModal.classList.remove("hidden");
    });
  }

  updateAuthUI();


  function switchPage(pageKey) {
    if (pageKey === "admin" && currentUserRole !== "admin") {
      showToast("Administrator role required to access Admin page.", "warning");
      return;
    }

    Object.keys(pages).forEach(key => {
      if (pages[key]) {
        if (key === pageKey) {
          pages[key].classList.remove("hidden");
          pages[key].classList.add("active");
        } else {
          pages[key].classList.add("hidden");
          pages[key].classList.remove("active");
        }
      }
      if (navLinks[key]) {
        if (key === pageKey) {
          navLinks[key].classList.add("active");
        } else {
          navLinks[key].classList.remove("active");
        }
      }
    });

    window.location.hash = pageKey === "dashboard" ? "" : pageKey;

    if (pageKey === "dashboard") {
      fetchQueue();
    } else if (pageKey === "admin") {
      fetchAdminConfig();
      fetchAdminMasterTable();
      fetchAdminFormFieldsTable();
      fetchAdminUserTable();
      fetchAiPrompt();
    } else if (pageKey === "training") {
      fetchMappingHistory();
    } else if (pageKey === "queue") {
      fetchQueue();
    }
  }

  window.switchPage = switchPage;
  if (window._pendingSwitchPageKey) {
    switchPage(window._pendingSwitchPageKey);
    delete window._pendingSwitchPageKey;
  }

  if (navLinks.dashboard) navLinks.dashboard.addEventListener("click", (e) => { e.preventDefault(); switchPage("dashboard"); });
  if (navLinks.invoice) navLinks.invoice.addEventListener("click", (e) => { e.preventDefault(); switchPage("invoice"); });
  if (navLinks.training) navLinks.training.addEventListener("click", (e) => { e.preventDefault(); switchPage("training"); });
  if (navLinks.queue) navLinks.queue.addEventListener("click", (e) => { e.preventDefault(); switchPage("queue"); });
  if (navLinks.admin) navLinks.admin.addEventListener("click", (e) => { e.preventDefault(); switchPage("admin"); });

  window.addEventListener("hashchange", () => {
    const hash = window.location.hash.toLowerCase();
    if (hash === "#training" || hash === "#ai-training-panel") switchPage("training");
    else if (hash === "#queue") switchPage("queue");
    else if (hash === "#admin" || hash === "#admin-panel") switchPage("admin");
    else if (hash === "#invoice" || hash === "#sap-invoice-window") switchPage("invoice");
    else switchPage("dashboard");
  });

  // Handle initial hash navigation
  const initHash = window.location.hash.toLowerCase();
  if (initHash === "#training" || initHash === "#ai-training-panel") switchPage("training");
  else if (initHash === "#queue") switchPage("queue");
  else if (initHash === "#admin" || initHash === "#admin-panel") switchPage("admin");
  else if (initHash === "#invoice" || initHash === "#sap-invoice-window") switchPage("invoice");

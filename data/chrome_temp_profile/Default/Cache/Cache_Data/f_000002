async function loadVendorAddressesForInvoice(vendorCode) {
  try {
    const allAddresses = window.vendorAddressesCache || [];
    const addresses = allAddresses
      .filter(a => a.name === vendorCode)
      .map(a => {
        try {
          const extra = JSON.parse(a.extra_data);
          return {
            address_code: a.code.split("::")[1] || a.code,
            address_type: extra.address_type || "ship",
            address_text: extra.address_text || "",
            building: extra.building || "",
            block: extra.block || "",
            street: extra.street || "",
            street_no: extra.street_no || "",
            address2: extra.address2 || "",
            address3: extra.address3 || "",
            city: extra.city || "",
            state: extra.state || "",
            country: extra.country || "",
            gst_regn_no: extra.gst_regn_no || "",
            is_default: extra.is_default || false
          };
        } catch(e) { return null; }
      })
      .filter(a => a !== null);
    
    const shipSel = document.getElementById("select-ship-to-code");
    const paySel = document.getElementById("select-pay-to-code");
    const shipTxt = document.getElementById("ship-to-address-text");
    const payTxt = document.getElementById("pay-to-address-text");

    const formatAddress = (a) => {
      const parts = [
        a.address_text, a.building, a.block, a.street, a.street_no, 
        a.address2, a.address3, a.city, a.state, a.country, 
        (a.gst_regn_no ? `GSTIN: ${a.gst_regn_no}` : '')
      ];
      return parts.filter(p => p && p.trim() !== "").join(", ");
    };

    let defaultShip = "";
    let defaultPay = "";
    const vendorData = window.vendorsMap && window.vendorsMap[vendorCode];
    if (vendorData && vendorData.extra_data) {
      try {
        const ve = typeof vendorData.extra_data === "string" ? JSON.parse(vendorData.extra_data) : vendorData.extra_data;
        defaultShip = ve.ship_to_code || ve.ShipToDefault || "";
        defaultPay = ve.pay_to_code || "";
      } catch(e) {}
    }

    if (shipSel) {
      let shipAddrs = addresses.filter(a => a.address_type === "ship");
      if (shipAddrs.length === 0) shipAddrs = addresses;
      
      let selectedIndex = 0;
      shipSel.innerHTML = `<option value="">-- Select Ship-To --</option>` + 
        shipAddrs.map((a, i) => {
          const isSel = (defaultShip && a.address_code === defaultShip) || (!defaultShip && a.is_default) || (i === 0 && !defaultShip && !shipAddrs.find(x => x.is_default));
          if (isSel) selectedIndex = i + 1;
          return `<option value="${a.address_code}" data-text="${formatAddress(a).replace(/"/g, '&quot;')}" ${isSel ? 'selected' : ''}>${a.address_code}${a.is_default ? ' (Default)' : ''}</option>`;
        }).join("");
      
      shipSel.selectedIndex = selectedIndex;
      if (shipSel.selectedIndex > 0 && shipTxt) {
        shipTxt.value = shipSel.options[shipSel.selectedIndex].getAttribute("data-text") || "";
      } else if (shipTxt) shipTxt.value = "";
    }
    
    if (paySel) {
      let payAddrs = addresses.filter(a => a.address_type === "pay");
      if (payAddrs.length === 0) payAddrs = addresses;
      
      let selectedIndex = 0;
      paySel.innerHTML = `<option value="">-- Select Pay-To --</option>` + 
        payAddrs.map((a, i) => {
          const isSel = (defaultPay && a.address_code === defaultPay) || (!defaultPay && a.is_default) || (i === 0 && !defaultPay && !payAddrs.find(x => x.is_default));
          if (isSel) selectedIndex = i + 1;
          return `<option value="${a.address_code}" data-text="${formatAddress(a).replace(/"/g, '&quot;')}" ${isSel ? 'selected' : ''}>${a.address_code}${a.is_default ? ' (Default)' : ''}</option>`;
        }).join("");
      
      paySel.selectedIndex = selectedIndex;
      if (paySel.selectedIndex > 0 && payTxt) {
        payTxt.value = paySel.options[paySel.selectedIndex].getAttribute("data-text") || "";
      } else if (payTxt) payTxt.value = "";
    }
  } catch (err) {
    console.error("Failed to fetch vendor addresses", err);
  }
}


// Custom Searchable Dropdown Implementation
function initCustomSearchableSelects() {
  document.querySelectorAll(".sap-grid-table select, .sap-header-box select").forEach(select => {
    if (select.dataset.searchableInitialized) return;

    select.dataset.searchableInitialized = "true";
    select.style.display = "none";

    const wrapper = document.createElement("div");
    wrapper.className = "custom-searchable-select";
    select.parentNode.insertBefore(wrapper, select);
    wrapper.appendChild(select);

    const display = document.createElement("div");
    display.className = "custom-searchable-display";
    wrapper.appendChild(display);

    const dropdown = document.createElement("div");
    dropdown.className = "custom-searchable-dropdown";
    document.body.appendChild(dropdown);

    const searchWrapper = document.createElement("div");
    searchWrapper.className = "custom-searchable-search";
    const searchInput = document.createElement("input");
    searchInput.type = "text";
    searchInput.placeholder = "Search...";
    searchWrapper.appendChild(searchInput);
    dropdown.appendChild(searchWrapper);

    const list = document.createElement("ul");
    list.className = "custom-searchable-list";
    dropdown.appendChild(list);

    function updateDisplay() {
      const selectedOpt = select.options[select.selectedIndex];
      display.textContent = selectedOpt ? selectedOpt.textContent : "-- Select --";
    }

    function buildList() {
      list.innerHTML = "";
      Array.from(select.options).forEach((opt, index) => {
        const li = document.createElement("li");
        li.textContent = opt.textContent;
        li.dataset.value = opt.value;
        li.dataset.index = index;
        if (opt.value === "__ADD_NEW__") li.className = "add-new";
        
        li.addEventListener("click", () => {
          select.selectedIndex = index;
          select.dispatchEvent(new Event("change", { bubbles: true }));
          updateDisplay();
          dropdown.classList.remove("open");
        });
        list.appendChild(li);
      });
      updateDisplay();
    }

    buildList();

    const observer = new MutationObserver(buildList);
    observer.observe(select, { childList: true });

    display.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = dropdown.classList.contains("open");
      document.querySelectorAll(".custom-searchable-dropdown").forEach(d => d.classList.remove("open"));
      if (!isOpen) {
        const rect = display.getBoundingClientRect();
        dropdown.style.top = (rect.bottom + window.scrollY) + "px";
        dropdown.style.left = (rect.left + window.scrollX) + "px";
        dropdown.style.minWidth = rect.width + "px";
        dropdown.style.width = "max-content";
        
        dropdown.classList.add("open");
        searchInput.value = "";
        Array.from(list.children).forEach(li => li.classList.remove("hidden"));
        // Use a small timeout to prevent focus from triggering an immediate scroll close
        setTimeout(() => {
          searchInput.focus({ preventScroll: true });
        }, 10);
      }
    });

    searchInput.addEventListener("input", (e) => {
      const term = e.target.value.toLowerCase();
      Array.from(list.children).forEach(li => {
        if (li.textContent.toLowerCase().includes(term)) {
          li.classList.remove("hidden");
        } else {
          li.classList.add("hidden");
        }
      });
    });

    document.addEventListener("click", (e) => {
      if (!wrapper.contains(e.target) && !dropdown.contains(e.target)) {
        dropdown.classList.remove("open");
      }
    });
    
    select.addEventListener("change", updateDisplay);
  });
}

window.addEventListener("scroll", (e) => {
  // Ignore scrolls that happen inside the dropdown itself
  if (e.target && e.target.classList && e.target.classList.contains("custom-searchable-list")) return;
  document.querySelectorAll(".custom-searchable-dropdown").forEach(d => d.classList.remove("open"));
}, true);

// Observe DOM for new selects
const domObserver = new MutationObserver(mutations => {
  let hasNewSelects = false;
  mutations.forEach(m => {
    if (m.addedNodes.length > 0) hasNewSelects = true;
  });
  if (hasNewSelects) initCustomSearchableSelects();
});
domObserver.observe(document.body, { childList: true, subtree: true });

document.addEventListener("DOMContentLoaded", initCustomSearchableSelects);
initCustomSearchableSelects();


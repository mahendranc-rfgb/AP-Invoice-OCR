  function renderQueueTable() {
    if (!documentsTbody) return;

    const filterVal = queueStatusFilter ? queueStatusFilter.value : "all";
    let filteredDocs = documentQueue;

    if (filterVal === "unposted") {
      filteredDocs = documentQueue.filter(d => d.status !== "POSTED");
    } else if (filterVal !== "all") {
      filteredDocs = documentQueue.filter(d => String(d.status).toUpperCase() === filterVal.toUpperCase());
    }

    if (filteredDocs.length === 0) {
      documentsTbody.innerHTML = `<tr><td colspan="8" class="empty-cell">No documents matching status filter '${filterVal}'.</td></tr>`;

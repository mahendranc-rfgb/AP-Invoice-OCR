  function filterSeriesByBranch() {
    const selectBranch = document.getElementById("select-branch");
    const selectSeries = document.getElementById("select-series");
    if (!selectBranch || !selectSeries) return;

    const selectedBranch = String(selectBranch.value).trim();
    const currentSeriesVal = selectSeries.value;
    const targetFY = "26-27"; // Current active financial year
    let firstValidVal = null;

    Array.from(selectSeries.options).forEach(opt => {
      if (opt.value === "" || opt.value === "__ADD_NEW__") return;
      const optBranch = opt.getAttribute("data-bpl-id");
      const optIndicator = opt.getAttribute("data-indicator");

      const matchBranch = !selectedBranch || !optBranch || String(optBranch) === String(selectedBranch);
      const matchFY = !optIndicator || optIndicator === targetFY || opt.textContent.includes(targetFY);

      if (matchBranch && matchFY) {
        opt.style.display = "";
        opt.disabled = false;
        if (!firstValidVal) firstValidVal = opt.value;
      } else {
        opt.style.display = "none";
        opt.disabled = true;
      }
    });

    // Fallback if no series matches FY for this branch
    if (!firstValidVal && selectedBranch) {
      Array.from(selectSeries.options).forEach(opt => {
        if (opt.value === "" || opt.value === "__ADD_NEW__") return;
        const optBranch = opt.getAttribute("data-bpl-id");
        if (!optBranch || String(optBranch) === String(selectedBranch)) {
          opt.style.display = "";
          opt.disabled = false;
          if (!firstValidVal) firstValidVal = opt.value;
        }
      });
    }

    const currentOpt = Array.from(selectSeries.options).find(o => o.value === currentSeriesVal);
    if (currentOpt && currentOpt.disabled && firstValidVal) {
      selectSeries.value = firstValidVal;
    }
  }


  async function loadMasterDataOptions() {
    try {
      const res = await fetch("/master-data");
      if (!res.ok) return;
      const data = await res.json();
      window.masterDataCache = data;

      const appendAddNew = (htmlStr) => htmlStr + `<option value="__ADD_NEW__" style="color: var(--sap-gold); font-weight: bold;">➕ Add New...</option>`;

      if (data.vendors) {
        document.querySelectorAll("select[name='sap_card_code'], #select-vendor-code").forEach(s => {
          const currentVal = s.value;
          s.innerHTML = appendAddNew(`<option value="" data-name="" data-gstin="" data-currency="" data-pay-to="" data-ship-to="" data-pay-terms="" data-pos="">-- Select Vendor --</option>` + data.vendors.map(v => {
            const safeName = (v.name || "").replace(/"/g, "&quot;");
            let extraObj = {};
            if (v.extra_data) {
              try {
                extraObj = typeof v.extra_data === "string" ? JSON.parse(v.extra_data) : v.extra_data;
              } catch(e) {
                extraObj = { gstin: v.extra_data };
              }
            }
            const gstinAttr = (extraObj.gstin || extraObj.FederalTaxID || "").replace(/"/g, "&quot;");
            const currAttr = (extraObj.currency || extraObj.Currency || "INR").replace(/"/g, "&quot;");
            const payToAttr = (extraObj.pay_to_code || extraObj.BilltoDefault || "").replace(/"/g, "&quot;");
            const shipToAttr = (extraObj.ship_to_code || extraObj.ShipToDefault || "").replace(/"/g, "&quot;");
            const payTermsAttr = String(extraObj.payment_terms || extraObj.PayTermsGrpCode || "-1").replace(/"/g, "&quot;");
            const wtaxLiableAttr = (extraObj.wtax_liable || "Yes").replace(/"/g, "&quot;");
            const wtCodeAttr = (extraObj.wt_code || "C004").replace(/"/g, "&quot;");
            const posAttr = (extraObj.place_of_supply || extraObj.BillToState || "TN").replace(/"/g, "&quot;");

            return `<option value="${v.code}" data-name="${safeName}" data-gstin="${gstinAttr}" data-currency="${currAttr}" data-pay-to="${payToAttr}" data-ship-to="${shipToAttr}" data-pay-terms="${payTermsAttr}" data-pos="${posAttr}" data-wtax-liable="${wtaxLiableAttr}" data-wt-code="${wtCodeAttr}">${v.code} — ${v.name}</option>`;
          }).join(""));
          if (currentVal && Array.from(s.options).some(o => o.value === currentVal)) s.value = currentVal;
        });
      }

      if (data.currencies && data.currencies.length > 0) {
        const selectCurr = document.getElementById("select-currency");
        if (selectCurr) {
          selectCurr.innerHTML = appendAddNew(data.currencies.map(c => `<option value="${c.code}">${c.code} — ${c.name}</option>`).join(""));
        }
      }

      if (data.series) {
        const selectSeries = document.getElementById("select-series");
        if (selectSeries) {
          selectSeries.innerHTML = appendAddNew(data.series.map(s => {
            let bplId = "";
            let indicator = "";
            let bplName = "";
            if (s.extra_data) {
              try {
                const extraObj = JSON.parse(s.extra_data);
                bplId = extraObj.bpl_id || "";
                bplName = extraObj.bpl_name || "";
                indicator = extraObj.indicator || "";
              } catch(e) {
                bplId = s.extra_data;
              }
            }
            let labelStr = `${s.code} — ${s.name}`;
            if (indicator) labelStr += ` - ${indicator}`;
            if (bplName) labelStr += ` - ${bplName}`;
            return `<option value="${s.code}" data-bpl-id="${bplId}" data-indicator="${indicator}">${labelStr}</option>`;
          }).join(""));
        }
      }

      if (data.branches) {
        const selectBranch = document.getElementById("select-branch");
        if (selectBranch) {
          selectBranch.innerHTML = appendAddNew(data.branches.map(b => `<option value="${b.code}">${b.code} — ${b.name}</option>`).join(""));
        }
      }

      filterSeriesByBranch();

      if (data.accounts) {
        document.querySelectorAll("select[name='gl_account']").forEach(s => {
          const currentVal = s.value;
          const expenseAccounts = data.accounts.filter(a => {
            const c = String(a.code);
            return c.startsWith('5') || c.startsWith('6') || c.startsWith('7') || c.startsWith('8') || c.startsWith('9') || a.name.toLowerCase().includes('expense');
          });
          const accountsToUse = expenseAccounts.length > 0 ? expenseAccounts : data.accounts;
          s.innerHTML = appendAddNew(accountsToUse.map(a => `<option value="${a.code}">${a.code} — ${a.name}</option>`).join(""));
          if (currentVal) s.value = currentVal;
          if (currentVal && Array.from(s.options).some(o => o.value === currentVal)) s.value = currentVal;
        });
      }

      if (data.tax_codes) {
        document.querySelectorAll("select[name='tax_code']").forEach(selectTax => {
          const currentVal = selectTax.value;
          selectTax.innerHTML = appendAddNew(data.tax_codes.map(t => `<option value="${t.code}" data-rate="${t.rate}">${t.code} (${t.rate}%)</option>`).join(""));
          if (currentVal && Array.from(selectTax.options).some(o => o.value === currentVal)) selectTax.value = currentVal;
        });
      }

      if (data.cost_centers1) {
        document.querySelectorAll("select[name='costing_code']").forEach(s => {
          const currentVal = s.value;
          s.innerHTML = appendAddNew(data.cost_centers1.map(c => `<option value="${c.code}">${c.code} — ${c.name}</option>`).join(""));
          if (currentVal && Array.from(s.options).some(o => o.value === currentVal)) s.value = currentVal;
        });
      }

      if (data.cost_centers2) {
        document.querySelectorAll("select[name='costing_code2']").forEach(s => {
          const currentVal = s.value;
          s.innerHTML = appendAddNew(data.cost_centers2.map(c => `<option value="${c.code}">${c.code} — ${c.name}</option>`).join(""));
          if (currentVal && Array.from(s.options).some(o => o.value === currentVal)) s.value = currentVal;
        });
      }

      if (data.cost_centers3) {
        document.querySelectorAll("select[name='costing_code3']").forEach(s => {
          const currentVal = s.value;
          s.innerHTML = appendAddNew(data.cost_centers3.map(c => `<option value="${c.code}">${c.code} — ${c.name}</option>`).join(""));
          if (currentVal && Array.from(s.options).some(o => o.value === currentVal)) s.value = currentVal;
        });
      }

      if (data.items) {
        document.querySelectorAll("select[name='sap_item_code']").forEach(s => {
          const currentVal = s.value;
          s.innerHTML = appendAddNew(`<option value="">-- ItemCode --</option>` + data.items.map(i => `<option value="${i.code}">${i.code} — ${i.name}</option>`).join(""));
          if (currentVal && Array.from(s.options).some(o => o.value === currentVal)) s.value = currentVal;
        });
      }

      if (data.wtax_codes) {
        document.querySelectorAll("select[name='wtax_code'], #select-wtax-code").forEach(s => {
          const currentVal = s.value;
          s.innerHTML = `<option value="">-- Select WHT Code --</option>` + data.wtax_codes.map(w => `<option value="${w.code}" data-rate="${w.extra_data}">${w.code} — ${w.name}</option>`).join("");
          if (currentVal && Array.from(s.options).some(o => o.value === currentVal)) s.value = currentVal;
        });
      }

      if (data.sac_entries) {
        window.sacEntriesCache = data.sac_entries;
        document.querySelectorAll("select[name='sac_entry']").forEach(s => {
          const currentVal = s.value;
          s.innerHTML = appendAddNew(`<option value="">-- SAC --</option>` + data.sac_entries.map(w => `<option value="${w.extra_data}">${w.code} — ${w.name}</option>`).join(""));
          if (currentVal && Array.from(s.options).some(o => o.value === currentVal)) s.value = currentVal;
        });
      }
      
      if (data.vendor_addresses) {
        window.vendorAddressesCache = data.vendor_addresses;
      }
    } catch (err) {
      console.error("Failed to load master data options:", err);
    }
  }

  loadMasterDataOptions();



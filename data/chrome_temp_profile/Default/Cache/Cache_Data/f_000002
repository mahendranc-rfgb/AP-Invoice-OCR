  function renderDashboardMetrics() {
    const totalDocs = documentQueue.length;
    const postedDocs = documentQueue.filter(d => d.status === "POSTED");
    const readyDocs = documentQueue.filter(d => d.validation && d.validation.passed);
    const reviewDocs = documentQueue.filter(d => d.status === "NEEDS_REVIEW");

    let totalVal = 0;
    documentQueue.forEach(d => {
      totalVal += parseFloat(d.invoice.totals.grand_total || 0);
    });

    const statTotal = document.getElementById("dash-stat-total");
    const statPosted = document.getElementById("dash-stat-posted");
    const statValue = document.getElementById("dash-stat-value");

    if (statTotal) statTotal.textContent = totalDocs;
    if (statPosted) statPosted.textContent = postedDocs.length;
    if (statValue) statValue.textContent = `INR ${totalVal.toLocaleString('en-IN', {minimumFractionDigits: 2})}`;

    // Bar distribution
    const postedPct = totalDocs > 0 ? ((postedDocs.length / totalDocs) * 100).toFixed(1) : 0;
    const readyPct = totalDocs > 0 ? ((readyDocs.length / totalDocs) * 100).toFixed(1) : 0;
    const reviewPct = totalDocs > 0 ? ((reviewDocs.length / totalDocs) * 100).toFixed(1) : 0;

    const barPosted = document.getElementById("dash-bar-posted");
    const barReady = document.getElementById("dash-bar-ready");

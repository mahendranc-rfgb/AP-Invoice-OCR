  async function uploadBulkInvoiceFiles(files) {
    uploadState.textContent = `Batch Extracting ${files.length} Bulk Invoices...`;
    const formData = new FormData();
    files.forEach(f => formData.append("files", f));

    try {
      showToast(`Uploading and processing OCR for ${files.length} bulk invoice documents...`, "info");
      const response = await fetch("/uploads/ocr/bulk", {
        method: "POST",
        body: formData,
      });

      if (!response.ok) {
        let errMsg = "Bulk OCR Extraction failed";
        try {
          const errData = await response.json();
          errMsg = errData.detail || errData.message || errMsg;
        } catch (e) {
          const text = await response.text();
          errMsg = text || errMsg;
        }
        throw new Error(errMsg);
      }

      const data = await response.json();
      uploadState.textContent = `Extracted ${data.processed} of ${data.total} bulk documents!`;
      extractionStatusPill.textContent = "Bulk Extraction Complete";
      extractionStatusPill.className = "pill success";

      await fetchQueue();
      showToast(`Bulk OCR Complete! Successfully extracted and queued ${data.processed} invoices in Document Queue.`, "success");

      // Automatically navigate to Document Queue so user can select documents one by one for SAP posting
      switchPage("queue");
    } catch (err) {
      showToast(err.message, "danger");
      uploadState.textContent = "Bulk upload failed";
    }
  }

  async function uploadInvoiceFile(file) {
    uploadState.textContent = `Processing OCR: ${file.name}...`;
    const formData = new FormData();
    formData.append("file", file);

    try {
      const response = await fetch("/uploads/ocr", {
        method: "POST",
        body: formData,
      });

      if (!response.ok) {
        let errMsg = "OCR Extraction failed";
        try {
          const errData = await response.json();
          errMsg = errData.detail || errData.message || errMsg;
        } catch (e) {
          const text = await response.text();
          errMsg = text || errMsg;
        }
        throw new Error(errMsg);
      }

      const data = await response.json();
      currentUploadId = data.upload_id;
      // Reset upload UI on success already handled elsewhere
      uploadState.textContent = `Extracted: ${data.filename}`;
      extractionStatusPill.textContent = data.extraction_status;
      extractionStatusPill.className = "pill success";

      ocrText.textContent = data.extracted_text || "Raw OCR Text ready.";
      ocrPreview.classList.remove("hidden");

      // Display field confidence badges
      ocrConfidence.innerHTML = "";
      if (data.field_confidence) {
        Object.entries(data.field_confidence).forEach(([field, score]) => {
          const badge = document.createElement("span");
          const confClass = score >= 90 ? "success" : score >= 80 ? "warning" : "danger";
          badge.className = `pill ${confClass}`;
          badge.textContent = `${field}: ${score}%`;
          ocrConfidence.appendChild(badge);
        });
      }

      if (data.upload_id) {
        const fileUrl = `/uploads/${data.upload_id}/file`;
        const frame = document.getElementById("doc-viewer-frame");
        const panel = document.getElementById("doc-viewer-panel");
        const extBtn = document.getElementById("btn-doc-external");
        if (frame) frame.src = fileUrl;
        if (extBtn) extBtn.href = fileUrl;
        if (panel) panel.classList.remove("hidden");
      }

      if (data.invoice) {
        populateFormWithInvoice(data.invoice);
      }

      showToast("Invoice OCR complete! Extracted document preview & values loaded side-by-side.", "success");
      updateStepper(2);
    } catch (err) {
      showToast(err.message, "danger");
      if (uploadState.textContent.startsWith("Processing OCR:")) {
        uploadState.textContent = "Upload failed";
      }
    }
  }


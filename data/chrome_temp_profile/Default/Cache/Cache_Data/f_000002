async function renderAdminWtaxTable() {
  try {
    const res = await fetch("/admin/wtax-codes");
    if (!res.ok) return;
    const codes = await res.json();
    const tbody = document.getElementById("admin-wtax-tbody");
    if (!tbody) return;

    if (codes.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" class="empty-cell">No WHT / TDS codes found.</td></tr>`;
      return;
    }

    tbody.innerHTML = codes.map(c => `
      <tr>
        <td><strong>${c.wtax_code}</strong></td>
        <td>${c.description}</td>
        <td><span class="pill gold">${c.wtax_rate.toFixed(2)}%</span></td>
        <td><code>${c.wtax_type === 'G' ? 'Gross' : 'Net'}</code></td>
        <td><span class="pill ${c.active ? 'success' : 'neutral'}">${c.active ? 'Active' : 'Inactive'}</span></td>
        <td>
          <button class="sap-btn outline" style="padding:0.15rem 0.4rem;font-size:0.72rem;color:var(--accent-rose);border-color:var(--accent-rose);" onclick="deleteWtaxCode('${c.wtax_code}')">🗑️ Delete</button>
        </td>
      </tr>
    `).join("");
  } catch (err) {
    console.error("Failed to render WHT codes", err);
  }

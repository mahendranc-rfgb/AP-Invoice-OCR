  // Consolidated 3-Step Workflow Implementation
  // Step 1: Validate Document (Save + Master Data Search + Rule Validation)
  invoiceForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const standardInvoicePayload = getFormInvoicePayload();

    try {
      showToast("Executing Document Validation with SAP Master-Data & Rules...", "info");

      if (currentDocument) {
        const response = await fetch(`/documents/${currentDocument.document_id}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(standardInvoicePayload),
        });
        if (!response.ok) throw new Error("Failed to update SAP document");
        currentDocument = await response.json();
      } else {
        const response = await fetch("/documents", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(standardInvoicePayload),
        });
        if (!response.ok) throw new Error("Failed to create SAP document");
        currentDocument = await response.json();
      }

      // Execute Master Data Search
      const mapRes = await fetch(`/documents/${currentDocument.document_id}/map`, { method: "POST" });
      if (mapRes.ok) {
        currentDocument = await mapRes.json();
      }

      // Execute Business Rule Validation
      const valRes = await fetch(`/documents/${currentDocument.document_id}/validate`, { method: "POST" });
      if (valRes.ok) {
        currentDocument = await valRes.json();
      }

      updateDocumentUI(currentDocument);
      populateFormWithInvoice(currentDocument.invoice);
      await fetchQueue();
      updateStepper(2);

      if (currentDocument.validation && currentDocument.validation.passed) {
        showToast("Document Validated Successfully! Step 1 Complete -> Ready for Authorization.", "success");
      } else {
        showToast("Document Validated with Warnings/Issues. Please review Console output.", "warning");
      }
    } catch (err) {
      showToast(err.message, "danger");
    }
  });


  function createNewRowHtml(templateTr = null) {
    const tbody = gridTable.querySelector("tbody");
    const tr = templateTr ? templateTr.cloneNode(true) : tbody.querySelector("tr").cloneNode(true);
    tr.classList.remove("selected-row");

    if (!templateTr) {
      tr.querySelectorAll("input").forEach(inp => {
        if (inp.name === "quantity") inp.value = "1";
        else if (inp.name === "tax_percentage") inp.value = "0";
        else if (inp.name === "unit_price") inp.value = "0.00";
        else if (inp.name === "line_number" || inp.classList.contains("row-num")) return;
        else inp.value = "";
      });
      const cellLineTotal = tr.querySelector(".line-total-cell");
      if (cellLineTotal) cellLineTotal.textContent = "INR 0.00";

    // Populate row selects from master data cache if available
    if (window.masterDataCache) {
      const data = window.masterDataCache;
      const appendAddNew = (htmlStr) => htmlStr + `<option value="__ADD_NEW__" style="color: var(--sap-gold); font-weight: bold;">➕ Add New...</option>`;

      const glSelect = tr.querySelector("select[name='gl_account']");
      if (glSelect && data.accounts) {
        const currentVal = glSelect.value;
        const expenseAccounts = data.accounts.filter(a => {
          const c = String(a.code);
          return c.startsWith('5') || c.startsWith('6') || c.startsWith('7') || c.startsWith('8') || c.startsWith('9') || a.name.toLowerCase().includes('expense');
        });
        const accountsToUse = expenseAccounts.length > 0 ? expenseAccounts : data.accounts;
        glSelect.innerHTML = appendAddNew(accountsToUse.map(a => `<option value="${a.code}">${a.code} — ${a.name}</option>`).join(""));
        if (currentVal && Array.from(glSelect.options).some(o => o.value === currentVal)) glSelect.value = currentVal;
      }

      const taxSelectEl = tr.querySelector("select[name='tax_code']");
      if (taxSelectEl && data.tax_codes) {
        const currentVal = taxSelectEl.value;
        taxSelectEl.innerHTML = appendAddNew(data.tax_codes.map(t => `<option value="${t.code}" data-rate="${t.rate}">${t.code} (${t.rate}%)</option>`).join(""));
        if (currentVal && Array.from(taxSelectEl.options).some(o => o.value === currentVal)) taxSelectEl.value = currentVal;
      }

      const cc1Select = tr.querySelector("select[name='costing_code']");
      if (cc1Select && data.cost_centers1) {
        const currentVal = cc1Select.value;
        cc1Select.innerHTML = appendAddNew(data.cost_centers1.map(c => `<option value="${c.code}">${c.code} — ${c.name}</option>`).join(""));
        if (currentVal && Array.from(cc1Select.options).some(o => o.value === currentVal)) cc1Select.value = currentVal;
      }

      const cc2Select = tr.querySelector("select[name='costing_code2']");
      if (cc2Select && data.cost_centers2) {
        const currentVal = cc2Select.value;
        cc2Select.innerHTML = appendAddNew(data.cost_centers2.map(c => `<option value="${c.code}">${c.code} — ${c.name}</option>`).join(""));
        if (currentVal && Array.from(cc2Select.options).some(o => o.value === currentVal)) cc2Select.value = currentVal;
      }

      const cc3Select = tr.querySelector("select[name='costing_code3']");
      if (cc3Select && data.cost_centers3) {
        const currentVal = cc3Select.value;
        cc3Select.innerHTML = appendAddNew(data.cost_centers3.map(c => `<option value="${c.code}">${c.code} — ${c.name}</option>`).join(""));
        if (currentVal && Array.from(cc3Select.options).some(o => o.value === currentVal)) cc3Select.value = currentVal;
      }

      const itemSelect = tr.querySelector("select[name='sap_item_code']");
      if (itemSelect && data.items) {
        const currentVal = itemSelect.value;
        itemSelect.innerHTML = appendAddNew(`<option value="">-- ItemCode --</option>` + data.items.map(i => `<option value="${i.code}">${i.code} — ${i.name}</option>`).join(""));
        if (currentVal && Array.from(itemSelect.options).some(o => o.value === currentVal)) itemSelect.value = currentVal;
      }
    }

    // Attach calculation listeners to inputs in new row
    tr.querySelectorAll("input, select").forEach(el => {
      el.addEventListener("input", calculateTotals);
      el.addEventListener("change", calculateTotals);
    });

    const taxSelect = tr.querySelector("select[name='tax_code']");
    if (taxSelect) {
      taxSelect.addEventListener("change", (e) => {
        const opt = e.target.options[e.target.selectedIndex];
        if (opt) {
          const rate = opt.getAttribute("data-rate");
          if (rate !== null && rate !== undefined) {
            const taxInp = tr.querySelector("input[name='tax_percentage']");
            if (taxInp) taxInp.value = rate;
            calculateTotals();
          }
        }
      });
    }

    const removeBtn = tr.querySelector(".btn-remove-row");
    if (removeBtn) {
      removeBtn.addEventListener("click", () => {
        const rows = tbody.querySelectorAll("tr");
        if (rows.length <= 1) {
          showToast("At least one line item row is required.", "warning");
          return;
        }
        tr.remove();
        reindexRows();
        calculateTotals();
      });
    }

    return tr;
  }

  async function promptAndCreateCustomOption(selectEl) {
    if (!selectEl) return;
    const nameAttr = selectEl.name || selectEl.id || "field";
    
    let category = "custom";
    let fieldLabel = "Master Data Option";
    
    if (nameAttr === "gl_account") { category = "accounts"; fieldLabel = "G/L Account"; }
    else if (nameAttr === "tax_code") { category = "tax_codes"; fieldLabel = "Tax Code"; }
    else if (nameAttr === "location_code") { category = "locations"; fieldLabel = "Location Code"; }
    else if (nameAttr === "costing_code") { category = "cost_centers1"; fieldLabel = "Costing Code (Cost Center 1)"; }
    else if (nameAttr === "costing_code2") { category = "cost_centers2"; fieldLabel = "Costing Code (Cost Center 2)"; }
    else if (nameAttr === "costing_code3") { category = "cost_centers3"; fieldLabel = "Costing Code (Cost Center 3)"; }
    else if (nameAttr === "sap_item_code") { category = "items"; fieldLabel = "SAP Item Code"; }
    else if (nameAttr === "sap_card_code") { category = "vendors"; fieldLabel = "Supplier / Card Code"; }
    else if (nameAttr === "local_currency" || nameAttr === "select-currency") { category = "currencies"; fieldLabel = "Currency"; }
    else if (nameAttr === "series" || nameAttr === "select-series") { category = "series"; fieldLabel = "Series"; }
    else if (nameAttr === "bpl_id_assigned_to_invoice" || nameAttr === "select-branch") { category = "branches"; fieldLabel = "Branch"; }

    const code = prompt(`Enter new custom Code for ${fieldLabel}:`);
    if (!code || !code.trim()) {
      selectEl.value = selectEl.getAttribute("data-last-val") || selectEl.options[0]?.value || "";
      return;
    }
    const cleanCode = code.trim();
    
    let extraData = "";
    let nameText = cleanCode;

    if (category === "tax_codes") {
      const rateInput = prompt(`Enter Tax Percentage Rate (%) for tax code '${cleanCode}':`, "18.00");
      extraData = rateInput ? rateInput.trim() : "0.00";
    }

    const descInput = prompt(`Enter Description / Name for '${cleanCode}' (optional):`, cleanCode);
    if (descInput && descInput.trim()) {
      nameText = descInput.trim();
    }

    let opt = Array.from(selectEl.options).find(o => o.value === cleanCode);
    if (!opt) {
      opt = document.createElement("option");
      opt.value = cleanCode;
      opt.textContent = category === "tax_codes" ? `${cleanCode} (${extraData}%)` : `${cleanCode} — ${nameText}`;
      if (category === "tax_codes") {
        opt.setAttribute("data-rate", extraData);
      }
      const addNewOpt = Array.from(selectEl.options).find(o => o.value === "__ADD_NEW__");
      if (addNewOpt) {
        selectEl.insertBefore(opt, addNewOpt);
      } else {
        selectEl.appendChild(opt);
      }
    }

    selectEl.value = cleanCode;
    selectEl.setAttribute("data-last-val", cleanCode);

    if (category === "tax_codes") {
      const tr = selectEl.closest("tr");
      if (tr) {
        const taxInp = tr.querySelector("input[name='tax_percentage']");
        if (taxInp && extraData) {
          taxInp.value = extraData;
        }
      }
    }
    if (category === "vendors") {
      setInputValue("supplier_name", nameText);
      opt.setAttribute("data-name", nameText);
    }

    calculateTotals();

    try {
      await fetch("/admin/master-data", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          category,
          code: cleanCode,
          name: nameText,
          extra_data: extraData,
          is_default: false
        })
      });
      showToast(`Added custom entry '${cleanCode}' to ${fieldLabel} master data!`, "success");
    } catch (err) {
      console.warn("Failed to persist custom master data option:", err);
      showToast(`Selected custom entry '${cleanCode}' for document posting.`, "info");
    }
  }


  function calculateTotals() {
    let totalSubtotal = 0;
    let totalTaxAmount = 0;
    let totalWTaxAmount = 0;
    let anyWtaxYes = false;

    gridTable.querySelectorAll("tbody tr").forEach((tr) => {
      const getVal = (name) => {
        const input = tr.querySelector(`[name="${name}"]`);
        return input ? input.value : "";
      };
      const qty = parseFloat(getVal("quantity")) || 0;
      const price = parseFloat(getVal("unit_price")) || 0;
      const taxPct = parseFloat(getVal("tax_percentage")) || 0;
      const wtaxLiable = getVal("wtax_liable");

      const subtotal = qty * price;
      const taxAmt = (subtotal * taxPct) / 100;
      const lineTotal = subtotal + taxAmt;

      totalSubtotal += subtotal;
      totalTaxAmount += taxAmt;

      if (wtaxLiable === "tYES" || wtaxLiable === "Yes" || wtaxLiable === "boYES") {
        anyWtaxYes = true;
      }

      const cellLineTotal = tr.querySelector(".line-total-cell");
      if (cellLineTotal) {
        cellLineTotal.textContent = `INR ${lineTotal.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
      }
      const inpLineTotal = tr.querySelector("input[name='line_total']");
      if (inpLineTotal) {
        inpLineTotal.value = lineTotal.toFixed(2);
      }
    });

    const roundoffEl = document.getElementById("footer-roundoff");
    const roundoff = roundoffEl ? (parseFloat(roundoffEl.value) || 0) : 0;

    // WHT alert banner + WHT amount calculation using selected code rate
    const wtaxBanner = document.getElementById("wtax-alert-banner");
    if (wtaxBanner) {
      if (anyWtaxYes) {
        wtaxBanner.classList.remove("hidden");
        // Calculate WTax amount from selected rate
        const wtaxCodeSel = document.getElementById("select-wtax-code");
        if (wtaxCodeSel && wtaxCodeSel.value) {
          const opt = wtaxCodeSel.options[wtaxCodeSel.selectedIndex];
          const rate = parseFloat(opt.getAttribute("data-rate") || "0");
          totalWTaxAmount = (totalSubtotal * rate) / 100;
          const rateDisp = document.getElementById("wtax-rate-display");
          if (rateDisp) rateDisp.value = rate.toFixed(2) + "%";
          const amtDisp = document.getElementById("wtax-amount-display");
          if (amtDisp) amtDisp.value = `INR ${totalWTaxAmount.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
        } else {
          totalWTaxAmount = 0;
          const rateDisp = document.getElementById("wtax-rate-display");
          if (rateDisp) rateDisp.value = "";
          const amtDisp = document.getElementById("wtax-amount-display");
          if (amtDisp) amtDisp.value = "";
        }
      } else {
        wtaxBanner.classList.add("hidden");
        totalWTaxAmount = 0;
        const rateDisp = document.getElementById("wtax-rate-display");
        if (rateDisp) rateDisp.value = "";
        const amtDisp = document.getElementById("wtax-amount-display");
        if (amtDisp) amtDisp.value = "";
      }
    }

    const grandTotal = totalSubtotal + totalTaxAmount + roundoff;

    const subEl = document.getElementById("footer-subtotal");
    if (subEl) subEl.textContent = `INR ${totalSubtotal.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
    const taxEl = document.getElementById("footer-tax");
    if (taxEl) taxEl.textContent = `INR ${totalTaxAmount.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
    const wtaxEl = document.getElementById("footer-wtax-amount");
    if (wtaxEl) wtaxEl.textContent = `INR ${totalWTaxAmount.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
    const grandEl = document.getElementById("footer-grand-total");
    if (grandEl) grandEl.textContent = `INR ${grandTotal.toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
  }

  window.recalculateInvoiceTotals = calculateTotals;


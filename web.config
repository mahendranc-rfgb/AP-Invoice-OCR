<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Configure HttpPlatformHandler to launch Python/Uvicorn -->
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    
    <!-- 
      processPath: The absolute path to python.exe (e.g. C:\Python313\python.exe or the virtual environment python)
      arguments: Instructs python to run uvicorn and bind to the port assigned by IIS (%HTTP_PLATFORM_PORT%)
    -->
    <httpPlatform processPath=".\.venv\Scripts\python.exe"
                  arguments="-m uvicorn app.main:app --port %HTTP_PLATFORM_PORT% --host 127.0.0.1"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\python-iis.log"
                  startupTimeLimit="60"
                  processesPerApplication="1">
      <environmentVariables>
        <!-- You can inject your environment variables here if you prefer not to use the .env file -->
        <environmentVariable name="DB_ENGINE" value="mssql" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>

